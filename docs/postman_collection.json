              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "work-orders",
                "{{orderId}}",
                "status"
              ]
            },
            "description": "Envía una transición permitida desde el estado actual."
          },
          "response": []
        },
        {
          "name": "Add item to work order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
