              ],
              "path": [
                "bikes"
              ],
              "query": [
                {
                  "key": "plate",
                  "value": "ABC",
                  "description": "Filtra por coincidencia parcial de placa."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get bike by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bikes/{{bikeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bikes",
                "{{bikeId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Work orders",
      "item": [
        {
          "name": "Create work order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('orderId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
