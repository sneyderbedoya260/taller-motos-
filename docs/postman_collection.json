    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('clientId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Pérez\",\n  \"phone\": \"3001234567\",\n  \"email\": \"ana.perez@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ]
            },
            "description": "Crea un cliente de ejemplo y guarda su ID en clientId."
          },
          "response": []
        },
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients?search=Ana",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Ana",
                  "description": "Busca por nombre o teléfono."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get client by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bikes",
      "item": [
        {
          "name": "Create bike",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('bikeId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"ABC123\",\n  \"brand\": \"Honda\",\n  \"model\": \"CB 190R\",\n  \"cylinder\": 190,\n  \"clientId\": \"{{clientId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bikes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bikes"
              ]
            },
            "description": "Crea una moto asociada al cliente guardado en clientId. Usa una placa no registrada."
          },
          "response": []
        },
        {
          "name": "List bikes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bikes?plate=ABC",
