              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bikeId\": \"{{bikeId}}\",\n  \"faultDescription\": \"Revisión general y cambio de aceite\",\n  \"entryDate\": \"2026-01-15T10:30:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/work-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "work-orders"
              ]
            },
            "description": "Crea una orden para la moto guardada en bikeId."
          },
          "response": []
        },
        {
          "name": "List work orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/work-orders?status=RECIBIDA&plate=ABC&page=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "work-orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "RECIBIDA",
                  "description": "Opcional. Estados: RECIBIDA, DIAGNOSTICO, EN_PROCESO, LISTA, ENTREGADA, CANCELADA."
                },
                {
                  "key": "plate",
                  "value": "ABC",
                  "description": "Opcional. Coincidencia parcial de placa."
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10",
                  "description": "Entre 1 y 100."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get work order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/work-orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "work-orders",
                "{{orderId}}"
